FOO-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, Integer32
        FROM SNMPv2-SMI;

foo MODULE-IDENTITY
    LAST-UPDATED "202111012136Z"
    ORGANIZATION "x"
    CONTACT-INFO "x"
    DESCRIPTION  "benign module"
    REVISION     "0001010000Z"
    DESCRIPTION  "old revision"
    ::= { 1 3 6 1 4 1 8072 9999 }

fooObject OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "an object"
    ::= { foo 1 }

END
