FOO-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, Integer32
        FROM SNMPv2-SMI;

foo MODULE-IDENTITY
    LAST-UPDATED "202111010000Z"
    ORGANIZATION "o"
    CONTACT-INFO "c"
    DESCRIPTION  "d"
    REVISION     "0001010000Z"
    DESCRIPTION  "first revision"
    ::= { 1 3 6 1 4 1 8072 9999 }

fooObject OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "an object"
    ::= { foo 1 }

END
