TEST-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, Integer32
        FROM SNMPv2-SMI;

test MODULE-IDENTITY
    LAST-UPDATED "202111010000Z"
    ORGANIZATION "org"
    CONTACT-INFO "ci"
    DESCRIPTION  "d"
    ::= { 1 3 6 1 4 1 9999 }

testObject OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "an object"
    ::= { test 1 }

END
