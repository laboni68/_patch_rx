FOO-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, Integer32
        FROM SNMPv2-SMI;

foo MODULE-IDENTITY
    LAST-UPDATED "200001010000Z"
    ORGANIZATION "x"
    CONTACT-INFO "x"
    DESCRIPTION  "benign module"
    REVISION     "200001010000Z"
    DESCRIPTION  "initial revision"
    ::= { 1 3 6 1 4 1 99999 1 }

END
