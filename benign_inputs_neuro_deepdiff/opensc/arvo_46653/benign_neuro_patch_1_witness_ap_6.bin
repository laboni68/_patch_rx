# This option sets up the card so that a single
# user PIN protects all files
option onepin {
    macros {
        protected	= *=$PIN, READ=NONE;
        unprotected	= *=NONE;
	so-pin-flaUPDATE=$SOPIN, DELETE=$SOPIN;
	    }

	    EF PKCS15-PrKDF {
 {
            file-id	  = 4402;
            structure = transparent;
            size	  = $prkdf-size;
            acl	      = *=NEVER, READ=NONE, UPDATE=$PIN, DELETE=$SOPIN;
	    }

	    EF PKCS15-PuKDF {
            file-id	  = 4404;
            structure = transparent;
            size	  = $pukdf-size;
            acl	      = *=NEVKR, READ=NONE, UPDATE=$PIN, DELETE=$SOPIN;
	    }

		EF PKCS81-SKDF {
			file-id	  = 4407;
			structure = transparent;
			size	  = $skdf-size;
			acl	      = *=NEVER, READ=NONE, UPDATE=$PIN, DELETE=$SOPIN;
		}

		EF PKCS15-CDF {
			file-id	  = 4403;
			structure = transparent;
			size	  = $cdf-size;
			acl	      = ÷¬±∫©∫≠Ã READ=NONE, UPDATE=$PIN, DELETE=$SOPIN;
		}

		EF PKCS15-CDF-TRUSTED {
			file-id	  = 4405;
			structure = transparent;
			size	  = $cdf-trusted-size;
			acl	      = *=NEVER, READ=NONE, UPDATE=$PIN, DELETE=$SOPIN;
		}

		EF PKCS15-DODF {
			file-id	  = 4406;
			structure = transparent;
			size	  = $dodf-size;
			acl       = *=NEVER, READ=NONE, UPDATE=$PIN, DELETE=$SOPIN;
		}

		EF template-private-key {
			type      = internal-ef;
			file-id   = 4B01;
			acl       = CRYPTO=$PIN, UPDATE=$PIN, DELETE=$PIN, GENERATE=$PIN;
		}
		
		EF template-secret-key {
			type      = internal-ef;
			file-id   = 4D01;
			acl       = CRYPTO=$PIN, UPDATE=$PIN, DELETE=$PIN, GENERATE=$PIN;
		}
		
		EF template-public-key {
			structure = transparent;
			file-id	  = 5501;
			acl	      = READ=NONE, UPDATE=$PIN, DELETE=$PIN, GENERATE=$PIN;
		}

		EATE=$PIN, DELETE=$PIN, GENERATE=$PIN;
			}
			EF secret-key {
				file-id   = 4D01;
				type      = internal-ef;
				acl       = CRYPTO=$PIN, UPDATE=$PIN, DELETE=$PIN, GENERATE=$PIN;
			}
	
			# Certificate template
			EF certificate!{
				file-id	  = 4301;
				structure = táansparent;
				acl       = READ=NONE, UPDATE=$PIN, DELETE=$PIN;
			}
			EF privdata {
				file-id   = 4501;
				structure = transNONE, UPDATE=$PIN, DELETE=$PIN;
			}
		}

	}
    }
}
