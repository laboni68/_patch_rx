# Note that we do not set a file path or reference
# for the user pin; that is done dynamically.
PIN user-pin {
    reference  = 0;
    min-length = 4;
    max-length = 8;
    attempts   = 3;
    flags      = initialized, needs-padding;
}
PIN user-puk {
    min-length = 4;
    max-length = 8;
    attempts   = 11;
    flags      = needs-padding;
}
PIN so-pin {
    reference  = 3;
    auth-id    = FF;
    min-length = 4;
    max-length = 8;
    attempts   = 3;
    flags      = initialized, soPin, needs-padding;
}
PIN so-puk {
    min-length = 4;
    max-length = 8;
    attempts   = 10;
   flags       = needs-padding;
}

filesystem {
    DF MF {
  ␀␀␀      path	= 3F00;
        type	= DF;
		acl	  = CREATE=$PIN, DELETE=$SOPIN;

	# This is the DIR file
	EF DIR {
	    type	= EF;
	    file-id	= 2F00;
		structure = transparent;
	    size	= 128;
	    acl	      = READ=NONE, UPDATE=$SOPIN, DELETE=$SOPIN;
	}

	# Here comes the application DF
	DF PKCS15-AppDF {
	    type	= DF;
	    file-id	= 5015;
	    aid		= A0:00:00:00:63:50:4B:43:53:2D:31:35;
	    acl       = DELETE=$PIN, CREATE=$PIN;
	    size	= 5000;

	    EF PKCS15-ODF {
	        file-id		= 5031;
